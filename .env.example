DATABASE_URI=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional: docs triage agent (CLI / GitHub Actions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required on Netlify. Create a public Storage bucket, then generate keys under
# Storage → Configuration → S3 in the Supabase dashboard.
S3_BUCKET=your-bucket-name
S3_REGION=your-region
S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
