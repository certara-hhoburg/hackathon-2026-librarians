DATABASE_URI=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional: docs triage agent (CLI / GitHub Actions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required on Netlify (and recommended with Supabase). Create a public Storage bucket,
# then enable S3 credentials under Project Settings → Storage → S3 access keys.
S3_BUCKET=media
S3_REGION=us-east-1
S3_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
